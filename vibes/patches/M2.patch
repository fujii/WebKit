From 471e472121b1b5c9986114e353baaa1cd829457f Mon Sep 17 00:00:00 2001
From: Fujii Hironori <fujii@igalia.com>
Date: Sun, 18 Oct 2026 01:50:25 +0900
Subject: [PATCH] [WPE] Support wp_fractional_scale_v1 in the Wayland platform

At a fractional output scale (e.g. 150%) the compositor advertises the
ceiled integer scale in wl_output, so WPEPlatform rendered 2x buffers that
the compositor then downscaled: 1.78x the pixels (and GPU memory) needed.

When the compositor provides wp_fractional_scale_manager_v1 and
wp_viewporter, create a wp_fractional_scale_v1 and a wp_viewport for the
toplevel surface, like GTK does. The preferred scale (in 1/120 units)
becomes the toplevel scale, the buffer scale stays 1, and the viewport
destination is set to the view size in logical pixels before each commit.
The maximized-state buffer size check allows the sub-pixel difference
caused by truncating the scaled view size.

Without the protocols (e.g. Weston) nothing changes.

* Source/WebKit/WPEPlatform/wpe/wayland/CMakeLists.txt:
* Source/WebKit/WPEPlatform/wpe/wayland/WPEDisplayWayland.cpp:
* Source/WebKit/WPEPlatform/wpe/wayland/WPEDisplayWaylandPrivate.h:
* Source/WebKit/WPEPlatform/wpe/wayland/WPEToplevelWayland.cpp:
* Source/WebKit/WPEPlatform/wpe/wayland/WPEToplevelWaylandPrivate.h:
* Source/WebKit/WPEPlatform/wpe/wayland/WPEViewWayland.cpp:
---
 .../WPEPlatform/wpe/wayland/CMakeLists.txt    | 25 ++++++
 .../wpe/wayland/WPEDisplayWayland.cpp         | 26 ++++++
 .../wpe/wayland/WPEDisplayWaylandPrivate.h    |  9 ++
 .../wpe/wayland/WPEToplevelWayland.cpp        | 89 +++++++++++++++++--
 .../wpe/wayland/WPEToplevelWaylandPrivate.h   |  1 +
 .../wpe/wayland/WPEViewWayland.cpp            |  8 +-
 6 files changed, 149 insertions(+), 9 deletions(-)

diff --git a/Source/WebKit/WPEPlatform/wpe/wayland/CMakeLists.txt b/Source/WebKit/WPEPlatform/wpe/wayland/CMakeLists.txt
index 128f0d8dfadb..25b264009163 100644
--- a/Source/WebKit/WPEPlatform/wpe/wayland/CMakeLists.txt
+++ b/Source/WebKit/WPEPlatform/wpe/wayland/CMakeLists.txt
@@ -198,6 +198,31 @@ if (EXISTS "${WAYLAND_PROTOCOLS_DATADIR}/unstable/xdg-decoration/xdg-decoration-
     list(APPEND WPEPlatformWayland_DEFINITIONS USE_XDG_DECORATION_UNSTABLE_V1=1)
 endif ()
 
+if (EXISTS "${WAYLAND_PROTOCOLS_DATADIR}/staging/fractional-scale/fractional-scale-v1.xml" AND EXISTS "${WAYLAND_PROTOCOLS_DATADIR}/stable/viewporter/viewporter.xml")
+    foreach (protocol_xml "staging/fractional-scale/fractional-scale-v1" "stable/viewporter/viewporter")
+        get_filename_component(protocol_name ${protocol_xml} NAME)
+        add_custom_command(
+            OUTPUT ${WPEPlatform_DERIVED_SOURCES_DIR}/wpe/wayland/${protocol_name}-protocol.c
+            MAIN_DEPENDENCY ${WAYLAND_PROTOCOLS_DATADIR}/${protocol_xml}.xml
+            DEPENDS ${WPEPlatform_DERIVED_SOURCES_DIR}/wpe/wayland/${protocol_name}-client-protocol.h
+            COMMAND ${WAYLAND_SCANNER} private-code
+                ${WAYLAND_PROTOCOLS_DATADIR}/${protocol_xml}.xml
+                ${WPEPlatform_DERIVED_SOURCES_DIR}/wpe/wayland/${protocol_name}-protocol.c
+            VERBATIM)
+
+        add_custom_command(
+            OUTPUT ${WPEPlatform_DERIVED_SOURCES_DIR}/wpe/wayland/${protocol_name}-client-protocol.h
+            MAIN_DEPENDENCY ${WAYLAND_PROTOCOLS_DATADIR}/${protocol_xml}.xml
+            COMMAND ${WAYLAND_SCANNER} client-header
+                ${WAYLAND_PROTOCOLS_DATADIR}/${protocol_xml}.xml
+                ${WPEPlatform_DERIVED_SOURCES_DIR}/wpe/wayland/${protocol_name}-client-protocol.h
+            VERBATIM)
+
+        list(APPEND WPEPlatformWayland_SOURCES ${WPEPlatform_DERIVED_SOURCES_DIR}/wpe/wayland/${protocol_name}-protocol.c)
+    endforeach ()
+    list(APPEND WPEPlatformWayland_DEFINITIONS USE_WP_FRACTIONAL_SCALE_V1=1)
+endif ()
+
 add_library(WPEPlatformWayland OBJECT ${WPEPlatformWayland_SOURCES})
 target_compile_definitions(WPEPlatformWayland PRIVATE ${WPEPlatformWayland_DEFINITIONS})
 target_include_directories(WPEPlatformWayland PRIVATE ${WPEPlatformWayland_PRIVATE_INCLUDE_DIRECTORIES})
diff --git a/Source/WebKit/WPEPlatform/wpe/wayland/WPEDisplayWayland.cpp b/Source/WebKit/WPEPlatform/wpe/wayland/WPEDisplayWayland.cpp
index 316471462cd7..c9477472f1d7 100644
--- a/Source/WebKit/WPEPlatform/wpe/wayland/WPEDisplayWayland.cpp
+++ b/Source/WebKit/WPEPlatform/wpe/wayland/WPEDisplayWayland.cpp
@@ -106,6 +106,10 @@ struct _WPEDisplayWaylandPrivate {
 #endif
 #if USE(XDG_DECORATION_UNSTABLE_V1)
     struct zxdg_decoration_manager_v1* xdgDecorationManager;
+#endif
+#if USE(WP_FRACTIONAL_SCALE_V1)
+    struct wp_fractional_scale_manager_v1* fractionalScaleManager;
+    struct wp_viewporter* viewporter;
 #endif
     Vector<std::pair<uint32_t, uint64_t>> linuxDMABufFormats;
     std::unique_ptr<WPE::WaylandSeat> wlSeat;
@@ -248,6 +252,10 @@ static void wpeDisplayWaylandDispose(GObject* object)
 #if USE(XDG_DECORATION_UNSTABLE_V1)
     g_clear_pointer(&priv->xdgDecorationManager, zxdg_decoration_manager_v1_destroy);
 #endif
+#if USE(WP_FRACTIONAL_SCALE_V1)
+    g_clear_pointer(&priv->fractionalScaleManager, wp_fractional_scale_manager_v1_destroy);
+    g_clear_pointer(&priv->viewporter, wp_viewporter_destroy);
+#endif
 #if USE(LIBDRM)
     g_clear_pointer(&priv->dmabufFeedback, zwp_linux_dmabuf_feedback_v1_destroy);
 #endif
@@ -307,6 +315,12 @@ const struct wl_registry_listener registryListener = {
 #if USE(XDG_DECORATION_UNSTABLE_V1)
         else if (interfaceName == "zxdg_decoration_manager_v1"_s)
             priv->xdgDecorationManager = static_cast<struct zxdg_decoration_manager_v1*>(wl_registry_bind(registry, name, &zxdg_decoration_manager_v1_interface, 1));
+#endif
+#if USE(WP_FRACTIONAL_SCALE_V1)
+        else if (interfaceName == "wp_fractional_scale_manager_v1"_s)
+            priv->fractionalScaleManager = static_cast<struct wp_fractional_scale_manager_v1*>(wl_registry_bind(registry, name, &wp_fractional_scale_manager_v1_interface, 1));
+        else if (interfaceName == "wp_viewporter"_s)
+            priv->viewporter = static_cast<struct wp_viewporter*>(wl_registry_bind(registry, name, &wp_viewporter_interface, 1));
 #endif
     },
     // global_remove
@@ -661,6 +675,18 @@ struct zxdg_decoration_manager_v1* wpeDisplayWaylandGetXDGDecorationManager(WPED
 }
 #endif // USE(XDG_DECORATION_UNSTABLE_V1)
 
+#if USE(WP_FRACTIONAL_SCALE_V1)
+struct wp_fractional_scale_manager_v1* wpeDisplayWaylandGetFractionalScaleManager(WPEDisplayWayland* display)
+{
+    return display->priv->fractionalScaleManager;
+}
+
+struct wp_viewporter* wpeDisplayWaylandGetViewporter(WPEDisplayWayland* display)
+{
+    return display->priv->viewporter;
+}
+#endif // USE(WP_FRACTIONAL_SCALE_V1)
+
 struct zwp_linux_explicit_synchronization_v1* wpeDisplayWaylandGetLinuxExplicitSync(WPEDisplayWayland* display)
 {
     return display->priv->linuxExplicitSync;
diff --git a/Source/WebKit/WPEPlatform/wpe/wayland/WPEDisplayWaylandPrivate.h b/Source/WebKit/WPEPlatform/wpe/wayland/WPEDisplayWaylandPrivate.h
index 33f29c1d9143..aae5fd0fe9ef 100644
--- a/Source/WebKit/WPEPlatform/wpe/wayland/WPEDisplayWaylandPrivate.h
