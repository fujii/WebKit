+// CPU pixels of a SW mask atlas. They are shared with the lazy proxy callback, which uploads the
+// area used by masks when the DDL is played back.
+class SWMaskAtlasPixels : public SkNVRefCnt<SWMaskAtlasPixels> {
+public:
+    explicit SWMaskAtlasPixels(SkISize dimensions)
+            : fDimensions(dimensions)
+            , fPixels(static_cast<uint8_t*>(sk_calloc_throw(dimensions.area()))) {}
+    ~SWMaskAtlasPixels() { sk_free(fPixels); }
+
+    SkISize dimensions() const { return fDimensions; }
+    size_t rowBytes() const { return fDimensions.width(); }
+    uint8_t* row(int y) { return fPixels + y * this->rowBytes(); }
+    const uint8_t* pixels() const { return fPixels; }
+
+    // The area that holds masks: the top left corner of the atlas.
+    SkISize usedSize() const { return fUsedSize; }
+    void addUsedRect(const SkIRect& rect) {
+        fUsedSize = {std::max(fUsedSize.width(), rect.right()),
+                     std::max(fUsedSize.height(), rect.bottom())};
+    }
+
+private:
+    SkISize fDimensions;
+    uint8_t* fPixels;
+    SkISize fUsedSize = {0, 0};
+};
+
+GrSurfaceProxyView make_sw_mask_atlas_view(GrRecordingContext* context,
+                                           sk_sp<SWMaskAtlasPixels> pixels) {
+    const GrCaps* caps = context->priv().caps();
+    GrBackendFormat format = caps->getDefaultBackendFormat(GrColorType::kAlpha_8,
+                                                           GrRenderable::kNo);
+    if (!format.isValid()) {
+        return {};
+    }
+    auto proxy = context->priv().proxyProvider()->createLazyProxy(
+            [pixels](GrResourceProvider* resourceProvider,
+                     const GrSurfaceProxy::LazySurfaceDesc& desc) {
+                GrMipLevel mipLevel = {pixels->pixels(), pixels->rowBytes(), nullptr};
+                const GrCaps* caps = resourceProvider->caps();
+                SkISize usedSize = pixels->usedSize();
+                if (usedSize != desc.fDimensions &&
+                    caps->writePixelsRowBytesSupport() &&
+                    caps->supportedWritePixelsColorType(GrColorType::kAlpha_8, desc.fFormat,
+                                                        GrColorType::kAlpha_8).fColorType ==
+                            GrColorType::kAlpha_8) {
+                    // Upload only the area that holds masks; the rest is never sampled.
+                    auto texture = resourceProvider->createTexture(desc.fDimensions,
+                                                                   desc.fFormat,
+                                                                   desc.fTextureType,
+                                                                   desc.fRenderable,
+                                                                   desc.fSampleCnt,
+                                                                   desc.fMipmapped,
+                                                                   desc.fBudgeted,
+                                                                   desc.fProtected,
+                                                                   desc.fLabel);
+                    if (texture && (usedSize.isEmpty() || resourceProvider->priv().gpu()->writePixels(
+                            texture.get(),
+                            SkIRect::MakeSize(usedSize),
+                            GrColorType::kAlpha_8,
+                            GrColorType::kAlpha_8,
+                            &mipLevel,
+                            1))) {
+                        return GrSurfaceProxy::LazyCallbackResult(std::move(texture));
+                    }
+                }
+                return GrSurfaceProxy::LazyCallbackResult(
+                        resourceProvider->createTexture(desc.fDimensions,
+                                                        desc.fFormat,
+                                                        desc.fTextureType,
+                                                        GrColorType::kAlpha_8,
+                                                        desc.fRenderable,
+                                                        desc.fSampleCnt,
+                                                        desc.fBudgeted,
+                                                        desc.fFit,
+                                                        desc.fProtected,
+                                                        mipLevel,
+                                                        desc.fLabel));
+            },
+            format,
+            pixels->dimensions(),
+            skgpu::Mipmapped::kNo,
+            GrMipmapStatus::kNotAllocated,
+            GrInternalSurfaceFlags::kNone,
+            SkBackingFit::kExact,
+            skgpu::Budgeted::kYes,
+            GrProtected::kNo,
+            GrSurfaceProxy::UseAllocator::kYes,
+            "ClipStack_SWMaskAtlas");
+    if (!proxy) {
+        return {};
+    }
+    skgpu::Swizzle swizzle = caps->getReadSwizzle(format, GrColorType::kAlpha_8);
+    return {std::move(proxy), kMaskOrigin, swizzle};
+}
