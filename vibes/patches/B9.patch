                          skgpu::ganesh::SurfaceDrawContext* sdc,
                          uint32_t genID,
@@ -824,6 +927,12 @@ bool ClipStack::Mask::appliesToDraw(const SaveRecord& current, const SkIRect& dr
 void ClipStack::Mask::invalidate(GrProxyProvider* proxyProvider) {
     SkASSERT(proxyProvider);
     SkASSERT(fKey.isValid()); // Should only be invalidated once
+    if (fAtlasView) {
+        // The key was never assigned to a proxy.
+        fAtlasView = {};
+        fKey.reset();
+        return;
+    }
     proxyProvider->processInvalidUniqueKey(
             fKey, nullptr, GrProxyProvider::InvalidateGPUResource::kYes);
     fKey.reset();
@@ -1188,6 +1297,55 @@ static constexpr int kMaxAnalyticFPs = 4;
 // across our set of GMs, SKPs, and SVGs used for testing.
 static constexpr int kNumStackMasks = 4;
 
+// Packs the small SW masks of a DDL recording into one texture, so that playing back the DDL
+// uploads one texture instead of one per mask.
+class ClipStack::SWMaskAtlas {
+public:
+    static constexpr int kSize = 1024;
+    static constexpr int kMaxMaskSize = 256;
+
+    static bool CanHold(const SkIRect& bounds) {
+        return bounds.width() <= kMaxMaskSize && bounds.height() <= kMaxMaskSize;
+    }
+
+    static std::unique_ptr<SWMaskAtlas> Make(GrRecordingContext* context) {
+        auto pixels = sk_make_sp<SWMaskAtlasPixels>(SkISize::Make(kSize, kSize));
+        auto view = make_sw_mask_atlas_view(context, pixels);
+        if (!view) {
+            return nullptr;
+        }
+        return std::unique_ptr<SWMaskAtlas>(new SWMaskAtlas(std::move(pixels), std::move(view)));
+    }
+
+    // Copies the mask into the atlas. Returns false if the atlas is full.
+    bool addMask(const SkPixmap& mask, SkIPoint* location) {
+        SkIPoint16 location16;
+        if (!fRectanizer.addRect(mask.width(), mask.height(), &location16)) {
+            return false;
+        }
+        for (int y = 0; y < mask.height(); ++y) {
+            memcpy(fPixels->row(location16.y() + y) + location16.x(), mask.addr8(0, y),
+                   mask.width());
+        }
+        fPixels->addUsedRect(SkIRect::MakeXYWH(location16.x(), location16.y(), mask.width(),
+                                               mask.height()));
+        *location = {location16.x(), location16.y()};
+        return true;
+    }
+
+    const GrSurfaceProxyView& view() const { return fView; }
+
+private:
+    SWMaskAtlas(sk_sp<SWMaskAtlasPixels> pixels, GrSurfaceProxyView view)
+            : fRectanizer(kSize, kSize)
+            , fPixels(std::move(pixels))
+            , fView(std::move(view)) {}
+
+    skgpu::RectanizerSkyline fRectanizer;
+    sk_sp<SWMaskAtlasPixels> fPixels;
+    GrSurfaceProxyView fView;
+};
+
 ClipStack::ClipStack(const SkIRect& deviceBounds, const SkMatrix* ctm, bool forceAA)
         : fElements(kElementStackIncrement)
         , fSaves(kSaveStackIncrement)
@@ -1532,7 +1690,7 @@ GrClip::Effect ClipStack::apply(GrRecordingContext* rContext,
             // Must use a texture mask to represent the combined clip elements since the stencil
             // cannot be used, or cannot handle smooth clips.
             std::tie(hasSWMask, clipFP) = GetSWMaskFP(
-                     rContext, &fMasks, cs, scissorBounds, elementsForMask.begin(),
+                     rContext, &fMasks, &fSWMaskAtlas, cs, scissorBounds, elementsForMask.begin(),
                      elementsForMask.size(), std::move(clipFP));
         }
 
@@ -1647,6 +1805,7 @@ void ClipStack::clip(RawElement&& element) {
 }
 
 GrFPResult ClipStack::GetSWMaskFP(GrRecordingContext* context, Mask::Stack* masks,
+                                  std::unique_ptr<SWMaskAtlas>* atlas,
                                   const SaveRecord& current, const SkIRect& bounds,
                                   const Element** elements, int count,
                                   std::unique_ptr<GrFragmentProcessor> clipFP) {
@@ -1654,14 +1813,20 @@ GrFPResult ClipStack::GetSWMaskFP(GrRecordingContext* context, Mask::Stack* mask
     GrSurfaceProxyView maskProxy;
 
     SkIRect maskBounds; // may not be 'bounds' if we reuse a large clip mask
+    SkIPoint atlasOffset = {0, 0}; // location of the mask in its texture
     // Check the existing masks from this save record for compatibility
     for (const Mask& m : masks->ritems()) {
         if (m.genID() != current.genID()) {
             break;
         }
         if (m.appliesToDraw(current, bounds)) {
-            maskProxy = proxyProvider->findCachedProxyWithColorTypeFallback(
-                    m.key(), kMaskOrigin, GrColorType::kAlpha_8, 1);
+            if (m.atlasView()) {
+                maskProxy = m.atlasView();
+                atlasOffset = m.atlasOffset();
+            } else {
+                maskProxy = proxyProvider->findCachedProxyWithColorTypeFallback(
+                        m.key(), kMaskOrigin, GrColorType::kAlpha_8, 1);
+            }
             if (maskProxy) {
                 maskBounds = m.bounds();
                 break;
@@ -1669,8 +1834,37 @@ GrFPResult ClipStack::GetSWMaskFP(GrRecordingContext* context, Mask::Stack* mask
         }
     }
 
+    // A DDL recording renders SW masks synchronously, and each one would be a separate texture
+    // upload at playback. Pack the small ones into an atlas instead.
+    if (!maskProxy && !context->asDirectContext() && SWMaskAtlas::CanHold(bounds)) {
+        SkAutoPixmapStorage pixels;
+        GrSWMaskHelper helper(&pixels);
+        if (helper.init(bounds)) {
+            for (int i = 0; i < count; ++i) {
+                draw_to_sw_mask(&helper, *(elements[i]), i == 0);
+            }
+            if (*atlas && !(*atlas)->addMask(pixels, &atlasOffset)) {
+                // The atlas is full. Draws recorded so far keep a reference to it.
+                atlas->reset();
+            }
+            if (!*atlas) {
+                *atlas = SWMaskAtlas::Make(context);
+                if (*atlas && !(*atlas)->addMask(pixels, &atlasOffset)) {
+                    atlas->reset();
+                }
+            }
+            if (*atlas) {
+                maskProxy = (*atlas)->view();
+                maskBounds = bounds;
+                // Register the mask so later draws with the same clip can reuse it.
+                masks->emplace_back(current, bounds).setAtlasLocation(maskProxy, atlasOffset);
+            }
+        }
+    }
+
     if (!maskProxy) {
         // No existing mask was found, so need to render a new one
+        atlasOffset = {0, 0};
         maskProxy = render_sw_mask(context, bounds, elements, count);
         if (!maskProxy) {
             // If we still don't have one, there's nothing we can do
@@ -1688,11 +1882,12 @@ GrFPResult ClipStack::GetSWMaskFP(GrRecordingContext* context, Mask::Stack* mask
 
     GrSamplerState samplerState(GrSamplerState::WrapMode::kClampToBorder,
                                 GrSamplerState::Filter::kNearest);
-    // Maps the device coords passed to the texture effect to the top-left corner of the mask, and
-    // make sure that the draw bounds are pre-mapped into the mask's space as well.
-    auto m = SkMatrix::Translate(-maskBounds.fLeft, -maskBounds.fTop);
+    // Maps the device coords passed to the texture effect to the top-left corner of the mask in
+    // its texture, and make sure that the draw bounds are pre-mapped into the mask's space as well.
+    auto m = SkMatrix::Translate(atlasOffset.fX - maskBounds.fLeft,
+                                 atlasOffset.fY - maskBounds.fTop);
     auto subset = SkRect::Make(bounds);
-    subset.offset(-maskBounds.fLeft, -maskBounds.fTop);
+    subset.offset(atlasOffset.fX - maskBounds.fLeft, atlasOffset.fY - maskBounds.fTop);
     // We scissor to bounds. The mask's texel centers are aligned to device space
     // pixel centers. Hence this domain of texture coordinates.
     auto domain = subset.makeInset(0.5, 0.5);
