         m_renderer->releaseMemory(critical);
 }
 
+void DrawingAreaCoordinatedGraphics::didSuspendForProcessSwap()
+{
+    // The page is now in the back/forward cache of this process and the UI process shows the new page with another
+    // drawing area. If this page is restored, the UI process creates a new drawing area too, and
+    // WebPage::reinitializeWebPage() replaces this one, so this drawing area won't render again. Destroy its renderer
+    // now instead of keeping its swap chain, tiles and compositing GPU context for as long as the page stays cached.
+    m_renderer = nullptr;
+}
