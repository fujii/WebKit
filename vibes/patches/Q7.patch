diff --git a/Source/WebKit/WPEPlatform/wpe/headless/WPEDisplayHeadless.cpp b/Source/WebKit/WPEPlatform/wpe/headless/WPEDisplayHeadless.cpp
index aefc200ef58e..03354103136c 100644
--- a/Source/WebKit/WPEPlatform/wpe/headless/WPEDisplayHeadless.cpp
+++ b/Source/WebKit/WPEPlatform/wpe/headless/WPEDisplayHeadless.cpp
@@ -49,6 +49,30 @@
 #include <xf86drm.h>
 #endif
 
+// A virtual screen, so that the web content sees a screen larger than the
+// view and window.resizeTo() can make the toplevel grow. Without any screen,
+// the screen rectangle falls back to the view bounds, so DOMWindow clamps
+// every resize request to the current view size.
+#define WPE_TYPE_SCREEN_HEADLESS (wpe_screen_headless_get_type())
+G_DECLARE_FINAL_TYPE(WPEScreenHeadless, wpe_screen_headless, WPE, SCREEN_HEADLESS, WPEScreen)
+
+struct _WPEScreenHeadlessPrivate {
+};
+WEBKIT_DEFINE_FINAL_TYPE(WPEScreenHeadless, wpe_screen_headless, WPE_TYPE_SCREEN, WPEScreen)
+
+static void wpe_screen_headless_class_init(WPEScreenHeadlessClass* klass)
+{
+    // There is no real output to synchronize with, so the display link uses a timer.
+    WPE_SCREEN_CLASS(klass)->get_sync_observer = [](WPEScreen*) -> WPEScreenSyncObserver* { return nullptr; };
+}
+
+static constexpr int headlessScreenWidth = 1920;
+static constexpr int headlessScreenHeight = 1080;
+// Physical size in millimeters giving about 96 DPI, the DPI assumed when there is no screen.
+static constexpr int headlessScreenPhysicalWidth = 508;
+static constexpr int headlessScreenPhysicalHeight = 286;
+static constexpr int headlessScreenRefreshRate = 60000;
+
 /**
  * WPEDisplayHeadless:
  *
@@ -63,6 +87,7 @@
  */
 struct _WPEDisplayHeadlessPrivate {
     std::optional<GRefPtr<WPEDRMDevice>> drmDevice;
+    GRefPtr<WPEScreen> screen;
 #if USE(GBM)
     UnixFileDescriptor gbmDeviceFD;
     struct gbm_device* gbmDevice;
@@ -83,11 +108,28 @@ static void wpeDisplayHeadlessDispose(GObject* object)
     G_OBJECT_CLASS(wpe_display_headless_parent_class)->dispose(object);
 }
 
-static gboolean wpeDisplayHeadlessConnect(WPEDisplay*, GError**)
+static gboolean wpeDisplayHeadlessConnect(WPEDisplay* display, GError**)
 {
+    auto* priv = WPE_DISPLAY_HEADLESS(display)->priv;
+    priv->screen = adoptGRef(WPE_SCREEN(g_object_new(WPE_TYPE_SCREEN_HEADLESS, "id", 1, nullptr)));
+    wpe_screen_set_position(priv->screen.get(), 0, 0);
+    wpe_screen_set_size(priv->screen.get(), headlessScreenWidth, headlessScreenHeight);
+    wpe_screen_set_physical_size(priv->screen.get(), headlessScreenPhysicalWidth, headlessScreenPhysicalHeight);
+    wpe_screen_set_refresh_rate(priv->screen.get(), headlessScreenRefreshRate);
     return TRUE;
 }
 
+static guint wpeDisplayHeadlessGetNScreens(WPEDisplay* display)
+{
+    return WPE_DISPLAY_HEADLESS(display)->priv->screen ? 1 : 0;
+}
+
+static WPEScreen* wpeDisplayHeadlessGetScreen(WPEDisplay* display, guint index)
+{
+    auto* priv = WPE_DISPLAY_HEADLESS(display)->priv;
+    return index ? nullptr : priv->screen.get();
+}
+
 static WPEView* wpeDisplayHeadlessCreateView(WPEDisplay* display)
 {
     return WPE_VIEW(g_object_new(WPE_TYPE_VIEW_HEADLESS, "display", display, nullptr));
@@ -180,6 +222,8 @@ static void wpe_display_headless_class_init(WPEDisplayHeadlessClass* displayHead
     displayClass->create_toplevel = wpeDisplayHeadlessCreateToplevel;
     displayClass->get_egl_display = wpeDisplayHeadlessGetEGLDisplay;
     displayClass->get_drm_device = wpeDisplayHeadlessGetDRMDevice;
+    displayClass->get_n_screens = wpeDisplayHeadlessGetNScreens;
+    displayClass->get_screen = wpeDisplayHeadlessGetScreen;
 }
 
 /**
diff --git a/Source/WebKit/WPEPlatform/wpe/headless/WPEToplevelHeadless.cpp b/Source/WebKit/WPEPlatform/wpe/headless/WPEToplevelHeadless.cpp
index 915cf1cb4f8d..7b9e91395d0d 100644
--- a/Source/WebKit/WPEPlatform/wpe/headless/WPEToplevelHeadless.cpp
+++ b/Source/WebKit/WPEPlatform/wpe/headless/WPEToplevelHeadless.cpp
@@ -60,6 +60,12 @@ static gboolean wpeToplevelHeadlessResize(WPEToplevel* toplevel, int width, int
     return TRUE;
 }
 
+static WPEScreen* wpeToplevelHeadlessGetScreen(WPEToplevel* toplevel)
+{
+    auto* display = wpe_toplevel_get_display(toplevel);
+    return display ? wpe_display_get_screen(display, 0) : nullptr;
+}
+
 static gboolean wpeToplevelHeadlessSetFullscreen(WPEToplevel* toplevel, gboolean fullscreen)
 {
     auto state = wpe_toplevel_get_state(toplevel);
@@ -77,6 +83,7 @@ static void wpe_toplevel_headless_class_init(WPEToplevelHeadlessClass* toplevelH
     objectClass->constructed = wpeToplevelHeadlessConstructed;
 
     WPEToplevelClass* toplevelClass = WPE_TOPLEVEL_CLASS(toplevelHeadlessClass);
+    toplevelClass->get_screen = wpeToplevelHeadlessGetScreen;
     toplevelClass->resize = wpeToplevelHeadlessResize;
     toplevelClass->set_fullscreen = wpeToplevelHeadlessSetFullscreen;
 }

